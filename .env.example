NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=debug

# O banco do desenvolvimento local é o Neon do stage dev, o mesmo das Lambdas (D22): a URL pooled
# (com -pooler no host), que é a mesma guardada no SSM em /myfood/dev/database-url.
DATABASE_URL=
# A URL direta (sem -pooler no host), usada pelas migrations e pelo drizzle-kit.
DATABASE_URL_UNPOOLED=

# Saem dos outputs do stack do Serverless:
#   aws cloudformation describe-stacks --stack-name myfood-api-dev \
#     --query 'Stacks[0].Outputs[].[OutputKey,OutputValue]' --output text
AWS_REGION=us-east-1
COGNITO_CUSTOMER_POOL_ID=
COGNITO_CUSTOMER_CLIENT_ID=
COGNITO_RESTAURANT_POOL_ID=
COGNITO_RESTAURANT_CLIENT_ID=

S3_BUCKET=
SQS_IMAGE_PROCESSING_URL=
SQS_ORDER_EVENTS_URL=
OUTBOX_RELAY_FUNCTION_NAME=
SETTLE_CHARGES_FUNCTION_ARN=
CHARGE_EXPIRY_SCHEDULER_ROLE_ARN=

# Opcional: a base das imagens processadas. Sem ela, é derivada do bucket e da região.
# MEDIA_BASE_URL=

# AbacatePay. A chave define o ambiente: chave de Dev mode simula, chave de produção cobra.
# O secret é inventado por você (openssl rand -hex 32) e cadastrado junto com o webhook.
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
# ABACATEPAY_API_URL=https://api.abacatepay.com/v2

# PAYMENT_PIX_EXPIRES_IN_SECONDS=1800

# Opcional: só é exigido pelo Expo se a conta ligar a segurança reforçada no envio de push.
# EXPO_ACCESS_TOKEN=

